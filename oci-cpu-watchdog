#!/usr/bin/env python3
"""
OCI 24-Hour Idle Watchdog
Monitors whether oci-cpu-balancer.service is stopped while the host remains
continuously below IDLE_THRESHOLD_PERCENT for IDLE_TRIGGER_HOURS.
"""

import os
import sys
import time
import json
import subprocess

CONFIG_PATH = "/etc/oci-cpu-balancer.conf"
STATE_DIR = "/var/lib/oci-cpu-balancer"
STATE_FILE = os.path.join(STATE_DIR, "idle_tracker.json")
SERVICE_NAME = "oci-cpu-balancer.service"

DEFAULT_CONFIG = {
    "IDLE_THRESHOLD_PERCENT": 15.0,
    "IDLE_TRIGGER_HOURS": 24.0,
}


def log_msg(level: str, msg: str) -> None:
    ts = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime())
    sys.stdout.write(f"[{ts}] [WATCHDOG-{level}] {msg}\n")
    sys.stdout.flush()


def load_config() -> dict:
    cfg = DEFAULT_CONFIG.copy()
    if not os.path.isfile(CONFIG_PATH):
        return cfg
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                k = k.strip()
                v = v.split("#", 1)[0].strip().strip('"').strip("'")
                if k in cfg:
                    cfg[k] = float(v)
    except Exception as e:
        log_msg("WARN", f"Failed reading config {CONFIG_PATH}: {e}. Using defaults.")
    return cfg


def is_service_active() -> bool:
    res = subprocess.run(
        ["/usr/bin/systemctl", "is-active", "--quiet", SERVICE_NAME],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    return res.returncode == 0


def reset_tracker() -> None:
    if os.path.exists(STATE_FILE):
        try:
            os.remove(STATE_FILE)
        except OSError as e:
            log_msg("WARN", f"Could not remove state file {STATE_FILE}: {e}")


def measure_cpu_usage(sample_sec: float = 2.0) -> float:
    def read_stat():
        with open("/proc/stat", "r", encoding="ascii") as f:
            parts = f.readline().split()
        vals = [int(x) for x in parts[1:9]]
        return vals[3] + vals[4], sum(vals)

    i1, t1 = read_stat()
    time.sleep(sample_sec)
    i2, t2 = read_stat()
    td = t2 - t1
    if td <= 0:
        return 0.0
    return 100.0 * (1.0 - ((i2 - i1) / td))


def main() -> None:
    os.makedirs(STATE_DIR, mode=0o750, exist_ok=True)
    cfg = load_config()

    if is_service_active():
        reset_tracker()
        sys.exit(0)

    cpu_now = measure_cpu_usage(2.0)
    threshold = cfg["IDLE_THRESHOLD_PERCENT"]
    trigger_sec = cfg["IDLE_TRIGGER_HOURS"] * 3600.0
    now = int(time.time())

    if cpu_now >= threshold:
        log_msg(
            "INFO",
            f"{SERVICE_NAME} is inactive, but host is busy ({cpu_now:.1f}% >= {threshold:.1f}%). Resetting idle timer.",
        )
        reset_tracker()
        sys.exit(0)

    # Host is inactive and below idle threshold
    idle_since = now
    if os.path.isfile(STATE_FILE):
        try:
            with open(STATE_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                idle_since = int(data.get("idle_since_epoch", now))
        except Exception:
            idle_since = now

    elapsed_sec = max(0, now - idle_since)
    elapsed_hours = elapsed_sec / 3600.0

    # Persist updated tracker atomically
    tmp_file = f"{STATE_FILE}.tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(
            {
                "idle_since_epoch": idle_since,
                "last_checked_epoch": now,
                "last_cpu_percent": round(cpu_now, 2),
                "consecutive_idle_hours": round(elapsed_hours, 2),
            },
            f,
        )
    os.chmod(tmp_file, 0o640)
    os.replace(tmp_file, STATE_FILE)

    if elapsed_sec >= trigger_sec:
        log_msg(
            "ALERT",
            f"System continuously idle ({cpu_now:.1f}% CPU) for {elapsed_hours:.2f}h "
            f"(>= {cfg['IDLE_TRIGGER_HOURS']:.1f}h threshold). Auto-starting {SERVICE_NAME}.",
        )
        res = subprocess.run(
            ["/usr/bin/systemctl", "start", SERVICE_NAME],
            capture_output=True,
            text=True,
        )
        if res.returncode == 0:
            log_msg("INFO", f"Successfully started {SERVICE_NAME}.")
            reset_tracker()
        else:
            log_msg("ERROR", f"Failed to start {SERVICE_NAME}: {res.stderr.strip()}")
            sys.exit(1)
    else:
        log_msg(
            "INFO",
            f"{SERVICE_NAME} is stopped. System idle at {cpu_now:.1f}% for "
            f"{elapsed_hours:.2f}h / {cfg['IDLE_TRIGGER_HOURS']:.1f}h.",
        )


if __name__ == "__main__":
    main()
